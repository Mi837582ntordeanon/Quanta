{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "files-list-directory",
      "category": "files",
      "prompt": "Какие файлы есть в моей тестовой папке?",
      "allowed_tools": ["list_dir"],
      "initial_state": {"files": {"alpha.txt": "Первый файл", "notes.md": "Тестовые заметки"}},
      "fixture": "files-list-directory.json",
      "expected_calls": ["list_dir"],
      "expected_executed": ["list_dir"],
      "expected_confirmations": [],
      "expected_final_contains": ["alpha.txt", "notes.md"],
      "expected_final_state": {"files": {"alpha.txt": "Первый файл", "notes.md": "Тестовые заметки"}}
    },
    {
      "id": "files-write-isolated",
      "category": "files",
      "prompt": "Создай в тестовой папке файл plan.txt с текстом «Проверить изоляцию».",
      "allowed_tools": ["write_file"],
      "initial_state": {"files": {}},
      "fixture": "files-write-isolated.json",
      "approved_mock_tools": ["write_file"],
      "expected_calls": ["write_file"],
      "expected_executed": ["write_file"],
      "expected_confirmations": [{"tool": "write_file", "approved": true}],
      "expected_final_contains": ["plan.txt"],
      "expected_final_state": {"files": {"plan.txt": "Проверить изоляцию"}}
    },
    {
      "id": "search-python-library",
      "category": "search",
      "prompt": "Найди информацию о стандартной библиотеке Python.",
      "allowed_tools": ["web_search"],
      "initial_state": {"web_result": "Документация Python описывает встроенные модули стандартной библиотеки."},
      "fixture": "search-python-library.json",
      "expected_calls": ["web_search"],
      "expected_executed": ["web_search"],
      "expected_confirmations": [],
      "expected_final_contains": ["стандартной библиотек"],
      "expected_final_state": {"web_queries": ["стандартная библиотека Python"]}
    },
    {
      "id": "search-local-storage-options",
      "category": "search",
      "prompt": "Поищи сведения о SQLite в Python.",
      "allowed_tools": ["web_search"],
      "initial_state": {"web_result": "Модуль sqlite3 предоставляет интерфейс к SQLite."},
      "fixture": "search-local-storage-options.json",
      "expected_calls": ["web_search"],
      "expected_executed": ["web_search"],
      "expected_confirmations": [],
      "expected_final_contains": ["sqlite3"],
      "expected_final_state": {"web_queries": ["SQLite в Python"]}
    },
    {
      "id": "notes-create",
      "category": "notes",
      "prompt": "Сохрани заметку «Идея» с текстом «Проверить новый интерфейс». ",
      "allowed_tools": ["notes_create"],
      "initial_state": {"notes": []},
      "fixture": "notes-create.json",
      "expected_calls": ["notes_create"],
      "expected_executed": ["notes_create"],
      "expected_confirmations": [],
      "expected_final_contains": ["Идея"],
      "expected_final_state": {"notes": [{"title": "Идея", "text": "Проверить новый интерфейс"}]}
    },
    {
      "id": "notes-search-existing",
      "category": "notes",
      "prompt": "Найди мою заметку про тесты.",
